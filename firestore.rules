rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sellers: allow users to read/write their own seller document
    match /sellers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow aggregation (count) queries on the sellers collection
    match /sellers/{document=**} {
      allow get, list: if true;
    }

    // Stores: allow users to read/write their own store document
    match /stores/{storeId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // StoreProfiles: allow public read, owner and sub-accounts can write
    match /storeProfiles/{userId} {
      allow read: if true;
      // Allow owner to write, or authenticated users updating lastInvoiceNumber
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastInvoiceNumber']))
      );
    }

    // Products: allow authenticated users to create products
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        // Allow if user owns the store OR if user's storeId matches product's storeId
        resource.data.storeId == request.auth.uid ||
        exists(/databases/$(database)/documents/storeProfiles/$(request.auth.uid))
      );
    }

    // Orders: allow authenticated users (including sales people) to create orders,
    // allow buyers to read/update their own orders,
    // allow sellers to read/update orders for their store.
    // Guest users (unauthenticated) may read a single order by its ID (for order tracking).
    // Note: guest checkout is handled server-side via Cloud Functions (admin SDK bypasses rules).
    match /orders/{orderId} {
      allow create, update: if request.auth != null;
      allow get: if true; // orderId is unguessable — safe to allow unauthenticated single-doc read for tracking
      allow list: if request.auth != null;
      // Allow deletion only for cancelled orders
      allow delete: if request.auth != null && resource.data.status == 'cancelled';
    }

    // Users -> follows: only owner can create/delete their follow docs
    match /users/{userId} {
      // Reads on the user document itself — adjust if you want public profile read
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /follows/{followId} {
        // Only the user (path owner) may create or delete follow records under their own user doc
        allow create: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        // Allow read by owner; adjust if you want public visibility
        allow read: if request.auth != null && request.auth.uid == userId;
      }

      // FCM push notification tokens — only the owning user can read/write
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Favorite stores — only the owning user can read/write
      match /favorites/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Favorite products — only the owning user can read/write
      match /favoriteProducts/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Store reviews: validated creation, public reads, owner-only edits/deletes
    match /storeReviews/{reviewId} {
      // Allow authenticated users to create reviews. Validate fields:
      // - userId must match the authenticated user
      // - storeId must be a string
      // - rating must be a number between 1 and 5
      // - createdAt should be a timestamp (use serverTimestamp on client)
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.storeId is string
        && request.resource.data.rating is number
  && request.resource.data.rating >= 1
  && request.resource.data.rating <= 5
  // Accept either a timestamp value or null (null covers client writes that use
  // serverTimestamp() which arrive as a fieldTransform instead of a concrete value)
  && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt == null);

      allow read: if true;

      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Product reviews: customers submit pending reviews; store owner moderates
    match /productReviews/{reviewId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.storeId is string
        && request.resource.data.productId is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.status == 'pending'
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt == null);

      allow read: if true;

      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.auth.uid == resource.data.storeId ||
        request.auth.uid == get(/databases/$(database)/documents/storeProfiles/$(resource.data.storeId)).data.ownerId
      );

      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.storeId ||
        request.auth.uid == get(/databases/$(database)/documents/storeProfiles/$(resource.data.storeId)).data.ownerId
      );
    }

    // Order notification delivery logs are server-managed; allow owners to read
    match /orderNotifications/{notificationId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.storeId ||
        request.auth.uid == get(/databases/$(database)/documents/storeProfiles/$(resource.data.storeId)).data.ownerId
      );
      allow create, update, delete: if false;
    }

    // Suppliers: only store owners can manage
    match /suppliers/{supplierId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.storeId;
      allow create, update, delete: if request.auth != null && request.auth.uid == request.resource.data.storeId;
    }

    // Raw Materials: only store owners can manage
    match /rawMaterials/{materialId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.storeId;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.storeId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.storeId;
    }

    // Purchases: only store owners can manage
    match /purchases/{purchaseId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.storeId;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.storeId;
      // Allow deletion only for returned or cancelled purchases
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.storeId && 
        (resource.data.status == 'returned' || resource.data.status == 'cancelled');
    }

    // Customer Returns (RMA): customers can create and read own, store owners can manage
    match /returnRequests/{returnId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.customerId;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == get(/databases/$(database)/documents/storeProfiles/$(resource.data.storeId)).data.ownerId
      );
      allow update: if request.auth != null && 
        request.auth.uid == get(/databases/$(database)/documents/storeProfiles/$(resource.data.storeId)).data.ownerId;
    }

    // Supplier Returns (SRA): only store owners can manage
    match /supplierReturns/{sraId} {
      allow read, create, update: if request.auth != null && request.auth.uid == request.resource.data.storeId;
      allow delete: if false; // Prevent deletion for audit trail
    }

    // Sales Returns: only store owners can manage
    match /salesReturns/{returnId} {
      allow read, create, update: if request.auth != null && request.auth.uid == request.resource.data.storeId;
      allow delete: if false; // Prevent deletion for audit trail
    }

    // Finished Goods Inventory: only store owners can manage
    match /finishedGoodsInventory/{itemId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.storeId;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.storeId;
      // Allow deletion only for items with 0 current stock
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.storeId && 
        resource.data.currentBalance == 0;
    }

    // Supplier Credits: only store owners can manage
    match /supplierCredits/{creditId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    // Staff: only store owners can manage
    match /staff/{staffId} {
      allow read, write: if request.auth != null;
    }

    // Expenses: store owners and managers can manage
    match /expenses/{expenseId} {
      allow read, create, update: if request.auth != null && request.auth.uid == request.resource.data.storeId;
    }

    // Audit Logs: read-only for owners, write allowed for authenticated users
    match /auditLogs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Contact messages: anyone can submit, only admins (server-side) can read
    match /contactMessages/{msgId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string;
      allow read, update, delete: if false;
    }

    // Store contact messages: anyone can submit, store owner can read
    match /storeContactMessages/{msgId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.storeId is string;
      allow read: if request.auth != null && request.auth.uid == resource.data.storeId;
      allow update, delete: if false;
    }

    // Customers (CRM): only store owners can manage
    match /customers/{customerId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // Recipes: only store owners can manage
    match /recipes/{recipeId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.storeId;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.storeId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.storeId;
    }

    // Production Batches: only store owners can manage
    match /productionBatches/{batchId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.storeId;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.storeId;
      // Allow deletion only for cancelled batches
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.storeId && 
        resource.data.status == 'cancelled';
    }

    // Sub-Accounts: only store owners can manage
    match /subAccounts/{accountId} {
      allow read, write: if request.auth != null;
    }

    // Purchase Orders: only store owners can manage
    match /purchaseOrders/{poId} {
      allow read, write: if request.auth != null;
    }

    // Composed Products: only store owners can manage
    match /composedProducts/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Salaries: only store owners can manage
    match /salaries/{salaryId} {
      allow read, write: if request.auth != null;
    }

    // Refund Transactions: only store owners can manage
    match /refundTransactions/{refundId} {
      allow read, write: if request.auth != null;
    }

    // SEO Events: public write (fire-and-forget tracker), authenticated read only
    match /seo_events/{eventId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // SEO Leads: public write (lead submissions), authenticated read only
    match /seo_leads/{leadId} {
      allow create: if request.resource.data.page_path is string
        && request.resource.data.created_at is timestamp;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // SEO Summary: public read (powers seo-report.html), no client write
    match /seo_summary/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // SEO Audits: authenticated read only, no client write (server Admin SDK only)
    match /seo_audits/{siteId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Account Payments: store owners can manage (customer receipts / supplier payouts)
    match /accountPayments/{paymentId} {
      allow read, create, update: if request.auth != null && request.auth.uid == request.resource.data.storeId;
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.storeId;
    }

    // Fallback: allow reads, deny writes by default
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}