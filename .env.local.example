# Local ecosystem rollout (copy to .env.local — never commit .env.local)
# All default OFF in production builds without these vars.

# Read enabledModules when pricingVersion=modular-v2
VITE_ECOSYSTEM_MODULAR=true

# Apply home.html module toggles on first store profile save
VITE_ECOSYSTEM_PACKAGE_DRAFT=true

# Gate admin routes by module (Phase 2 — do not enable yet)
# VITE_ECOSYSTEM_ENFORCE_MODULES=true

# Storefront composed stock via POST /public/product-stock (enable with functions deploy)
# VITE_PUBLIC_PRODUCT_STOCK_API=true

# Phase 7 — hide legacy tier UI (after one billing cycle on modular-v2)
# VITE_LEGACY_TIERS_RETIRED=true

# Builder accounts Phase 2 (local dev — routes /onboarding/builder, /builder)
# VITE_BUILDER_ACCOUNTS=true
# ECOSYSTEM_MODULAR=true
# ECOSYSTEM_ENFORCE_MODULES=true

# Cloudflare R2 product image uploads (staging test). When enabled, product
# images upload to R2 via POST /api/r2/presign instead of Firebase Storage.
# The presign endpoint returns the public URL (built from server R2_PUBLIC_URL);
# VITE_R2_PUBLIC_URL is documented here for reference/fallback only.
# VITE_R2_UPLOAD_ENABLED=true
# VITE_R2_PUBLIC_URL=https://pub-2221e2fa2e024e92b1f253e9fc7887c4.r2.dev
