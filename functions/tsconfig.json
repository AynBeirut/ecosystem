{
  "compilerOptions": {
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "node16",
    "target": "ES2020",
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "express"],
    "typeRoots": ["./node_modules/@types"]
  }
}